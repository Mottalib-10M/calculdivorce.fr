---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_URL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { breadcrumbSchema } from '../../lib/seo';
const lang = 'en';
const code = `<iframe src="${SITE_URL}/embed/calculator/" title="Embed the French child support calculator" width="100%" height="980" style="border:0;max-width:1100px" loading="lazy"></iframe>`;
---
<PageLayout title="Embed the French child support calculator on your site" description="Embed the French child support calculator for free in an iframe: one line of code to copy, no sign-up, no tracker, the calculation runs entirely in the browser." lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: 'Home', path: route('home', lang) }, { name: 'Widget', path: route('widget', lang) }])]} breadcrumbs={[{ label: 'Widget' }]} showAuthor={false}>
  <header class="mb-6">
    <h1 class="text-3xl font-bold text-navy-900 md:text-4xl">Embed the French child support calculator</h1>
    <p class="mt-3 text-lg text-navy-600">Copy one line of code, no sign-up, no fee. The widget loads the full calculator in an iframe served from this site: parents’ groups, family mediators, legal advice points and newsrooms can install it in a minute.</p>
  </header>
  <div class="prose prose-slate max-w-none">
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code}</code></pre>
    <p>Terms: the credit link shown below the calculator must stay visible, the widget must not be altered, and it comes with no warranty. Rates are updated on this site, so your embed stays current without any work.</p>
    <p>No visitor data reaches us: the calculation runs in their browser and the iframe sets no cookie. Questions? Write to us from the <a href={route('contact', lang)}>contact page</a>.</p>
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200">
    <iframe src="/embed/calculator/" title="Embed the French child support calculator" width="100%" height="980" style="border:0" loading="lazy"></iframe>
  </div>
</PageLayout>
