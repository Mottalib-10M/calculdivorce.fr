---
import PageLayout from '../../layouts/PageLayout.astro';
import DivorceCalculator from '../../components/calc/DivorceCalculator';
import ContentTable from '../../components/ContentTable.astro';
import Sources from '../../components/Sources.astro';
import AdSlot from '../../components/AdSlot.astro';
import { YEAR, LAST_UPDATED, LANG_TAGS } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { label } from '../../i18n/nav';
import { rel } from '../../lib/links';
import { webApplicationSchema, faqSchema, breadcrumbSchema, organizationSchema, personSchema, websiteSchema } from '../../lib/seo';
import { pension, P } from '../../lib/engine/pension';
import { methodesPC, soulte, delaiMinimalConsentement, fiscalPC } from '../../lib/engine/divorce';
import { formatMoney, formatPercent, displayDate } from '../../lib/format';
const lang = 'en';
const $ = (x: number) => formatMoney(x, 0, lang);
const D = P.divorce, PC = P.prestation_compensatoire;
const exP = pension(3600, 2, 'classique');
const exM = methodesPC(3600, 1700, 15);
const exS = soulte(280000, 120000, 0.5);
const exF = fiscalPC(exM.mediane, 'capital12', 3600 * 12);
const taux = formatPercent(P.partage.taux_divorce, 2, lang);
const title = `Divorce in France ${YEAR}: Support, Settlement and Soulte`;
const description = `Divorce in France in ${YEAR}: work out child support, an indicative compensatory payment, the soulte on the home, the partition duty and regulated fees. Free.`;
const faqs = [
  { q: 'How much does a divorce cost in France?', a: `Most of the price is lawyers’ fees, which are not regulated and are set in a written fee agreement. On top come a few regulated charges: ${formatMoney(D.depot_notaire_ttc, 2, lang)} including VAT to file a mutual consent agreement with a notary, and a ${taux} partition duty on the net assets divided when there is property. A shared home also requires a notarial deed, with a proportional regulated fee.` },
  { q: 'Do I need a French lawyer to divorce?', a: 'Yes. A mutual consent divorce without a judge requires one lawyer per spouse, and a lawyer is compulsory in every court-based divorce. The two spouses cannot share a lawyer. Only the end of a PACS can be handled without one, by a joint declaration or by having a commissaire de justice serve notice. Legal aid can cover some or all of the fees, depending on your income.' },
  { q: 'Who keeps the family home after a French divorce?', a: `There are three outcomes: the home is sold and the proceeds are divided; one spouse keeps it and pays the other a soulte; or both remain joint owners under a written agreement. The soulte is usually half the net value, meaning the market value minus the loan still owed. The spouse who keeps the home also takes over the loan, if the bank agrees, and pays the ${taux} partition duty.` },
  { q: 'Is a compensatory payment automatic in France?', a: 'No. It has to be claimed, and the agreement or the judge grants it only if the divorce creates a disparity in the spouses’ living conditions. The judge may refuse it on grounds of fairness, in particular when the divorce is granted on the exclusive fault of the spouse asking for it. It is normally a lump sum, and exceptionally a life annuity when age or health requires it.' },
  { q: 'What money changes hands on the day of the divorce?', a: 'One-off sums: the soulte if one spouse keeps the home, the compensatory payment if paid as a lump sum, the partition duty, the filing fee and the lawyers. Then recurring sums: child support every month, and possibly a compensatory payment paid in instalments, over eight years at most unless the judge gives reasons for a longer period.' },
  { q: 'Will separating change my French income tax this year?', a: 'Yes. In the year of the separation each spouse files a separate return for the whole year, with only their own income. You must report the change within 60 days in your impots.gouv.fr account so that the withholding rate is recalculated. A parent raising the children alone ticks box T and gets an extra half share as a single parent.' },
  { q: 'Can a former spouse receive a survivor’s pension in France?', a: `Yes, under the general scheme, from age ${P.reversion.rg_age} and subject to an income ceiling, even if they now live with someone; it is shared with a surviving spouse in proportion to the length of each marriage. Under Agirc-Arrco, the former spouse is entitled to ${formatPercent(P.reversion.aa_taux, 0, lang)} of the deceased’s points, with no income test, unless they have remarried.` },
  { q: 'Can this site put me in touch with a lawyer?', a: 'No, and that is deliberate. Calcul Divorce sells no referrals, consultations or quotes: it publishes calculations based on official texts and scales, and says where they stop. For advice on your own case, the points-justice offer free legal consultations, and legal aid can pay for a lawyer depending on your income.' },
];
const related = rel(['pc', 'soulte', 'cout', 'cm', 'pension', 'impots'], lang);
const jsonLd = [webApplicationSchema({ name: `Divorce calculator France ${YEAR}`, description, path: route('home', lang), lang }), faqSchema(faqs, lang), breadcrumbSchema([{ name: 'Home', path: route('home', lang) }]), organizationSchema(lang), personSchema(lang), websiteSchema(lang)];
const links = { [label('pension', lang)]: route('pension', lang), [label('pc', lang)]: route('pc', lang), [label('soulte', lang)]: route('soulte', lang), [label('cout', lang)]: route('cout', lang) };
---
<PageLayout title={title} description={description} lang={lang} jsonLd={jsonLd} faqs={faqs} related={related}>
  <header class="mb-6">
    <h1 class="text-3xl font-bold text-navy-900 md:text-4xl">Divorce in France {YEAR}: the money side, worked out item by item</h1>
    <p class="mt-3 text-lg text-navy-600">Incomes, length of marriage, children, home: one set of inputs gives <strong>child support, a compensatory payment range, the soulte and the regulated fees</strong>, each computed from official French sources.</p>
    <p class="mt-3"><span class="inline-flex items-center gap-1.5 rounded-full border border-navy-200 bg-white px-3 py-1 text-xs font-medium text-navy-600">Ministry of Justice table · partition duty {taux} · notary filing {formatMoney(D.depot_notaire_ttc, 2, lang)} · checked {displayDate(LAST_UPDATED, LANG_TAGS[lang])}</span></p>
  </header>
  <div class="clamp mb-6">
    <input type="checkbox" id="intro-more" class="clamp-toggle" aria-label="Read more" />
    <p class="text-navy-700">A French divorce moves money in four ways, each with its own rule. Child support follows the French Ministry of Justice reference table: on {$(3600)} net a month with two children living with the other parent, it comes to {$(exP.total)} a month. <span class="clamp-rest">The compensatory payment (prestation compensatoire) has no legal scale; the three methods practitioners use put the same couple, married fifteen years with the other spouse earning {$(1700)}, somewhere between {$(exM.min)} and {$(exM.max)}. The soulte buys out the share of the spouse who leaves the home: {$(exS.soulte)} for a house worth {$(280000)} with {$(120000)} still owed. Finally the State levies a {taux} partition duty on the net assets, here {$(exS.droitPartage)}, and the notary charges {formatMoney(D.depot_notaire_ttc, 2, lang)} to file an amicable agreement. If you are used to divorce in the UK, Ireland or North America, note that France has no single financial order: these items are settled separately, under different rules.</span></p>
    <label for="intro-more" class="clamp-more" aria-hidden="true">Read more</label>
  </div>
  <DivorceCalculator client:load lang="en" methodHref={route('method', lang)} links={links} />
  <AdSlot slot="home-1" />
  <section class="prose prose-slate max-w-none">
    <h2 id="items">What the calculator adds up, and what it leaves out</h2>
    <p>It adds up what can be calculated from a public text or scale: the table’s child support, the partition duty under article 746 of the French Tax Code, the fixed fee for filing the agreement, and the {formatPercent(PC.reduction_taux, 0, lang)} tax reduction on a compensatory payment made as a lump sum within twelve months. In the example above, if the better-off spouse paid the median of the methods, {$(exM.mediane)}, in one go, they would get {$(exF.economie)} back on their income tax.</p>
    <p>It leaves out what is negotiated or freely billed: lawyers’ fees, any property valuer, the notary’s proportional fee on the deed of partition, and above all the real amount of the compensatory payment, which the judge sets case by case. The calculator says so on each line rather than showing a total that would look like a quote.</p>
    <h2 id="procedures">French divorce procedures side by side</h2>
    <p>The Civil Code knows four grounds for divorce. The first is settled without a judge in most cases; the other three go before the family court judge (juge aux affaires familiales, JAF), with a lawyer for each spouse.</p>
    <ContentTable caption="Grounds for divorce and what they involve" headers={['Procedure', 'Judge', 'Waiting time specific to it', 'Known regulated fees']} align={['l', 'l', 'l', 'l']} rows={[
      ['Mutual consent by lawyers’ agreement', 'no, agreement filed with a notary', `${D.reflexion_jours}-day cooling-off before signing`, `filing ${formatMoney(D.depot_notaire_ttc, 2, lang)} incl. VAT + partition duty`],
      ['Mutual consent in court', 'yes, if a minor child asks to be heard', 'approval hearing', 'partition duty'],
      ['Acceptance of the breakdown', 'yes', 'none', 'partition duty'],
      ['Definitive breakdown of the marriage', 'yes', `${D.alteration_cessation_vie_commune_mois} months living apart when the claim is filed`, 'partition duty'],
      ['Fault', 'yes', 'none', 'partition duty, possible damages'],
    ]} />
    <p>The amicable route is the fastest: at the tightest, {delaiMinimalConsentement()} days separate sending the draft agreement from filing it with the notary. Details are on the pages on <a href={route('cm', lang)}>mutual consent divorce</a>, <a href={route('faute', lang)}>fault-based divorce</a> and <a href={route('delais', lang)}>how long a divorce takes</a>; the full budget, lawyers included, is on the <a href={route('cout', lang)}>cost of divorce</a> page.</p>
    <h2 id="money">The money that changes hands</h2>
    <h3>For the children: child support</h3>
    <p>It is based on the income of the parent the children do not live with, minus a subsistence amount, multiplied by a rate that depends on the number of children and the visiting arrangements. It continues after 18 until the child is financially independent. The <a href={route('pension', lang)}>child support calculator</a> adds the CAF’s family support allowance and the tax effect on both sides.</p>
    <h3>Between spouses: the compensatory payment</h3>
    <p>It makes up for the drop in living standards the divorce causes, taking into account the length of the marriage, age, health, career choices made for the family and pension rights. With no scale, the <a href={route('pc', lang)}>compensatory payment</a> page compares three practitioners’ methods and the tax on a lump sum, instalments and an annuity.</p>
    <h3>Property: division, soulte and buy-out</h3>
    <p>Most couples married in France without a contract are under the community of acquests: each spouse receives half the net community assets, adjusted for reimbursements, which the page on <a href={route('partage', lang)}>dividing assets</a> calculates. When one keeps the home, they owe a <a href={route('soulte', lang)}>soulte</a>, often funded with a <a href={route('rachat', lang)}>buy-out loan</a>. The {taux} partition duty applies in every case, including after <a href={route('pacs', lang)}>ending a PACS</a> or a <a href={route('sepcorps', lang)}>legal separation</a>.</p>
    <AdSlot slot="home-2" />
    <h2 id="tax-caf">Tax and CAF: what changes in the year of separation</h2>
    <p>Two returns instead of one, tax shares reallocated, support deductible for one and taxable for the other: the page on <a href={route('impots', lang)}>tax in the year of divorce</a> compares the couple’s tax before with the two taxes after. With shared residence, family allowances can be split in half and tax shares always are; the page on <a href={route('cafalt', lang)}>shared custody and CAF benefits</a> works out both households. A parent raising a child alone with no support, or support below {formatMoney(P.asf.montant_par_enfant, 2, lang)}, can claim the <a href={route('asf', lang)}>family support allowance</a>.</p>
    <h2 id="pension">Later on: pensions and survivor’s benefits</h2>
    <p>Divorce does not cut every tie with the former spouse’s pension. Under the general scheme, a divorced spouse keeps a right to the survivor’s pension, {formatPercent(P.reversion.rg_taux, 0, lang)} of the deceased’s basic pension, shared in proportion to the length of each marriage if the deceased remarried. Under Agirc-Arrco, the right disappears if the former spouse remarries. The page on the <a href={route('reversion', lang)}>survivor’s pension after divorce</a> works out both shares, income ceiling included.</p>
    <h2 id="positioning">What this site does, and what it does not do</h2>
    <p>Calcul Divorce informs and calculates. It is not a law firm, gives no legal advice, sells no quotes or referrals and takes no commission. Its figures come from Légifrance, service-public.fr, justice.fr, the tax administration, the CAF and the pension funds; each one is dated in a parameters file and tested at every release. The amounts shown are estimates: only the family court judge or your divorce agreement sets them.</p>
    <Sources lang="en" />
  </section>
</PageLayout>
